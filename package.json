{
  "name": "@reclaimprotocol/zk-fetch",
  "version": "2.1.0",
  "description": "HTTPS Fetch with a zkproof of correctness of fetch",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "scripts"
  ],
  "tsup": {
    "entry": [
      "src/index.ts",
      "src/tee-library.ts"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true,
    "external": [
      "@reclaimprotocol/tls",
      "@reclaimprotocol/tls/webcrypto",
      "@reclaimprotocol/zk-symmetric-crypto",
      "koffi"
    ]
  },
  "scripts": {
    "build": "sh build.sh",
    "postinstall": "node scripts/postinstall.js",
    "download:circuits": "node node_modules/@reclaimprotocol/zk-symmetric-crypto/lib/scripts/download-files",
    "test": "vitest"
  },
  "author": "madhavanmalolan",
  "license": "SEE LICENSE IN https://github.com/reclaimprotocol/zk-fetch/blob/master/LICENSE.md",
  "dependencies": {
    "@reclaimprotocol/attestor-core": "^5.1.6",
    "@swc/core": "^1.6.13",
    "ethers": "^5.7.2",
    "pino": "^8.20.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.12"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reclaimprotocol/zk-fetch"
  },
  "keywords": [
    "zk",
    "fetch",
    "reclaimprotocol"
  ],
  "overrides": {
    "ws": "^8.21.0",
    "underscore": "^1.13.8",
    "esbuild": "^0.28.1"
  }
}
